# ---- Core ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
DOCS_ENABLED=true                  # set false to hide /docs, /redoc, /openapi.json
ALLOWED_HOSTS=*                    # production: comma separated hostnames, e.g. api.example.com

# ---- Infrastructure -----------------------------------------------------------------
#production_db=postgresql://neondb_owner:npg_Dx5SsoO7zQZV@ep-jolly-pond-b1gtcrea-pooler.c-5.eu-central-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL=postgresql+asyncpg://natheel:natheel@localhost:5432/natheel
REDIS_URL=redis://localhost:6379/0

# ---- Admin access (/adminnatheel/) ----------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Signs the admin session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=change-me-generate-a-random-48-byte-secret
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SAMESITE=lax          # lax is required: the OAuth callback is a cross-site top-level redirect
# ADMIN_COOKIE_SECURE=true         # defaults to true when ENVIRONMENT=production

# ---- Token encryption -----------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several comma separated keys enable rotation (first key encrypts, all keys decrypt).
ENCRYPTION_KEY=RQPLR743LwdIU1DJ1hw_n6tgS5tphjf3yCnumWs7Fg0=

# ---- URLs -------------------------------------------------------------------------------
FRONTEND_URL=https://natheelco.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://www.natheelco.com
BACKEND_PUBLIC_URL=http://localhost:8000   # public HTTPS URL of this API; used for OAuth redirect URIs
FRONTEND_SOCIAL_ACCOUNTS_PATH=/adminnatheel/social-accounts
# Public base URL where social platforms can download uploaded media (Meta pulls images/videos by URL).
# Defaults to BACKEND_PUBLIC_URL/media-files. Must be reachable from the internet over HTTPS.
MEDIA_PUBLIC_BASE_URL=

# ---- Mailbox (admin "Emails" page) -----------------------------------------------------
# natheelco.com's MX records point at Google (aspmx.l.google.com), so the mailbox is Google
# Workspace and the Gmail API is used. Leave EMAIL_PROVIDER=gmail unless the domain moves.
EMAIL_PROVIDER=gmail
# Optional: pre-selects the account on Google's consent screen.
EMAIL_LOGIN_HINT=Natheelcoalkhaleej@gmail.com
# Where the OAuth callback returns the admin inside the frontend.
FRONTEND_EMAILS_PATH=/adminnatheelcoir
#
# Credentials: the GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET pair below is reused (the same Google
# Cloud project can serve both YouTube and Gmail). One scope is requested and nothing more:
#   https://www.googleapis.com/auth/gmail.modify   (read messages + toggle the UNREAD label)
# No send scope is requested, because replies open in Gmail instead of being sent from here.
#
# Setup, once, in Google Cloud Console (console.cloud.google.com):
#   1. Pick or create a project.
#   2. APIs & Services -> Library -> enable "Gmail API".
#   3. OAuth consent screen -> add the gmail.modify scope above. On a managed Workspace domain an
#      administrator may also have to approve the app for the domain.
#   4. Credentials -> Create credentials -> OAuth client ID -> Web application. Under
#      "Authorized redirect URIs" add this exact value (it must match character for character,
#      and must be HTTPS in production):
#         <BACKEND_PUBLIC_URL>/api/emails/oauth/callback
#      e.g. http://localhost:8000/api/emails/oauth/callback for local development.
#   5. Put the client id and secret in GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET below, restart the
#      backend, then open the admin panel -> "البريد الإلكتروني" and press the connect button.
# Tokens are encrypted with ENCRYPTION_KEY before being stored and are never sent to the browser.

# ---- Ministry of Tourism news (admin "News" page) --------------------------------------
# Articles published within this many days are badged "new". The feed itself is read from the
# Ministry's public CMS (cms.tourism.sa) and needs no credentials.
NEWS_NEW_DAYS=14

# ---- Storage ----------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=536870912

# ---- OAuth "Connect Account" apps (separate from the Social Media Hub below; used by the
#      /adminnatheel/social-accounts OAuth connect flow, app/integrations/social/*) --------------
# ---- Meta (Facebook Pages + Instagram) --------------------------------------------------------
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v21.0

# ---- LinkedIn ------------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202506        # YYYYMM of an active LinkedIn API version

# ---- TikTok --------------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY     # un-audited apps can only post privately

# ---- Google / YouTube -------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_PRIVACY_STATUS=private     # private | unlisted | public (public requires an audited API project)

# ---- Social Media Hub (admin "منشورات التواصل الاجتماعي" tab) ----------------------------
# Facebook, Instagram, X, YouTube, Pinterest, TikTok, and Threads are published exclusively
# through Zoho Social below. Only LinkedIn and Snapchat are not connected inside Zoho, so
# they keep their own direct tokens in the "Social Accounts" section further down.

# ---- Zoho Social --------------------------------------------------------------------------
# Routes ZOHO_NETWORKS through the Zoho Social portal instead of each network's direct API.
# https://www.zoho.com/social/api/introduction.html
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://social.zoho.com
ZOHO_PORTAL_ID=
ZOHO_BRAND_ID=
ZOHO_NETWORKS=tiktok,twitter,youtube,facebookpage,instagram,pinterest,threadsbyig
ZOHO_PINTEREST_BOARD_ID=

# ---- Publishing / retries ---------------------------------------------------------------------
PUBLISH_MAX_RETRIES=5
PUBLISH_BACKOFF_BASE_SECONDS=30
PROVIDER_HTTP_TIMEOUT_SECONDS=30
PROVIDER_UPLOAD_TIMEOUT_SECONDS=900

# ---- Rate limiting ("<requests>/<window seconds>") -----------------------------------------
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_LOGIN=5/60
RATE_LIMIT_OAUTH=20/60
RATE_LIMIT_PUBLISH=30/60
RATE_LIMIT_UPLOAD=60/60

# ---- Social Accounts (not Zoho-managed) -----------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_PROFILE_ID=