# Social Media Hub credentials
# Fill in the values below. Leave a line empty until you have that network's token.
# This file stays on the server. Do not put these values in the frontend.
#
# File location:
#   natheel back/natheel back/backend/social.env
#
# After saving, click "نشر المنشور (Post Now)" again. You do not need to restart
# the backend. Tokens are read from this file on every publish.

# Public HTTPS base where Instagram, Snapchat, and TikTok photos can download files.
# Example: https://your-domain.example/media-files
# Leave empty while developing on localhost. Networks that must fetch the file
# themselves will report that this value is still required.
MEDIA_PUBLIC_BASE_URL=

# ---- Instagram (Meta Graph API, Instagram professional account) --------------
# Create an app at https://developers.facebook.com/
# Page token scopes: instagram_basic, instagram_content_publish,
# pages_show_list, pages_read_engagement; add instagram_manage_insights for insights.
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---- LinkedIn ----------------------------------------------------------------
# Token needs w_member_social (person) or w_organization_social (company page).
# Organization follower metrics require approved Community Management access.
# LINKEDIN_AUTHOR_URN examples:
#   urn:li:person:YOUR_ID
#   urn:li:organization:YOUR_ID
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202506

# ---- X / Twitter -------------------------------------------------------------
# From https://developer.x.com/ — user context keys (OAuth 1.0a), not a bearer token.
# The app needs Read and Write permission. public_metrics availability depends on the X API plan.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- TikTok ------------------------------------------------------------------
# Content Posting API user access token with video.publish.
# Add user.info.stats to return follower/account totals.
# Unaudited apps can only post with SELF_ONLY. Use PUBLIC_TO_EVERYONE after approval.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ---- YouTube -----------------------------------------------------------------
# OAuth scope: https://www.googleapis.com/auth/youtube.upload
# Prefer a refresh token plus the OAuth client for automatic renewal.
# YOUTUBE_PRIVACY_STATUS: public | unlisted | private
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=public

# ---- Pinterest ---------------------------------------------------------------
# Token scopes: pins:read, pins:write, boards:read, user_accounts:read.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# ---- Snapchat ----------------------------------------------------------------
# OAuth app from Snap Business Manager, allowlisted for Public Profile
# Content Management (CreateMedia and story posting). The server creates a
# fresh access token on every Snapchat call from these values.
# Put the long-lived OAuth token in SNAPCHAT_REFRESH_TOKEN.
# SNAPCHAT_ACCESS_TOKEN is optional and is used as that long-lived token when
# SNAPCHAT_REFRESH_TOKEN is empty.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_PROFILE_ID=
